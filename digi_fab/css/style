/* ページ全体 */
body {
  margin: 0;
  background: #f7f5f0;
  color: #292823;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
  line-height: 1.9;
}

/* 本文の幅と配置 */
body > * {
  box-sizing: border-box;
}

body {
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* 見出し */
h1 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 5vw, 3.2rem);
  line-height: 1.3;
}

h2 {
  margin: 64px 0 20px;
  padding-left: 14px;
  border-left: 5px solid #e58b43;
  font-size: 1.8rem;
  line-height: 1.4;
}

h3 {
  margin: 36px 0 12px;
  color: #8b4d28;
  font-size: 1.25rem;
}

/* 文章 */
p {
  margin: 0 0 20px;
}

/* 画像 */
img {
  display: block;
  max-width: 100%;
  height: auto;
  margin: 20px auto;
  border-radius: 12px;
}

/* リンク */
a {
  color: #a95024;
  text-underline-offset: 4px;
}

a:hover {
  color: #e58b43;
}

/* スマートフォン */
@media (max-width: 600px) {
  body {
    padding: 24px 18px 56px;
  }

  h2 {
    margin-top: 48px;
    font-size: 1.5rem;
  }
}